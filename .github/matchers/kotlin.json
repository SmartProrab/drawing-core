{
  "problemMatcher": [
    {
      "owner": "kotlin-compiler-error",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^e: file://.*/drawing-core/(.+?):(\\d+):(\\d+) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    },
    {
      "owner": "kotlin-compiler-warning",
      "severity": "warning",
      "pattern": [
        {
          "regexp": "^w: file://.*/drawing-core/(.+?):(\\d+):(\\d+) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
